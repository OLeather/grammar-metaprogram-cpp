load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "syntax",
    hdrs = ["syntax.h"],
    deps = ["//source:grammar",]
)

cc_library(
    name = "ast",
    hdrs = ["ast.h"],
    deps = [":syntax",]
)

cc_library(
    name = "node_printer",
    hdrs = ["node_printer.h"],
    deps = [":syntax",]
)

cc_binary(
    name = "main",
    srcs = ["main.cpp"],
    deps = [":syntax", ":ast", ":node_printer",]
)
